{
  "name": "atlas",
  "productName": "Atlas",
  "version": "0.2.0",
  "private": true,
  "description": "Résumé screening with a local model",
  "author": "Aryan Gupta",
  "license": "UNLICENSED",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "demo": "node scripts/demo.mjs",
    "demo:fast": "node scripts/demo.mjs --fast",
    "demo:reset": "node scripts/demo.mjs --reset",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "gen:api": "node scripts/gen-api-types.mjs",
    "test": "vitest run",
    "e2e": "electron-vite build && playwright test",
    "e2e:ci": "electron-vite build && playwright test --grep-invert @perf",
    "predist": "node scripts/check-engine.mjs",
    "dist": "electron-vite build && electron-builder --config electron-builder.yml --publish never",
    "lint": "eslint scripts",
    "format": "prettier --check \"main/**/*.ts\" \"preload/**/*.ts\" \"renderer/**/*.{ts,tsx,css}\" \"src/**/*.ts\" \"e2e/**/*.ts\" \"scripts/**/*.mjs\"",
    "postinstall": "node -e \"require('electron')\""
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "jsdom": "^30.1.1",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.2",
    "zustand": "^5.0.15"
  }
}
