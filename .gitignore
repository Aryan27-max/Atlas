# Python
.venv/
__pycache__/
*.pyc

# Runtime data (SQLite + WAL/SHM side files, partial downloads)
*.db*
*.part

# Local real data (never committed)
local/
*.xlsx
# …except the fictional demo list (engine/tests/demo_stubs.py writes it)
!docs/demo/demo-students.xlsx
*.xls
*.db
*.db-wal
*.db-shm

# App build output and dependencies
app/node_modules/
app/out/
app/dist/
# Engine build (packaging/build_engine.py): the PyInstaller folder, its work
# files and the build-only virtual environment
/dist/
/build/
app/test-results/
app/playwright-report/

# graphify: only the report is committed (graph.json/graph.html are large and
# rewritten on every refresh; manifest/cache are machine-specific).
graphify-out/cache/
graphify-out/*
!graphify-out/GRAPH_REPORT.md

# The owner's local notes for making a release by hand (not part of the repository)
binaryDeploy.md
