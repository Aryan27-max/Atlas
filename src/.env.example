# Copy this file to .env.local and fill in real values. Never commit .env files.
# On Vercel, add the same variables under Project → Settings → Environment Variables.

# ── Sign-in ───────────────────────────────────────────────────────────────────
# The one username and password that unlock the downloads page. The password must be at
# least 12 characters and not the example below: weak or example values keep sign-in off.
APP_USERNAME=recruiter
APP_PASSWORD=replace-with-a-long-unique-password

# Signs the session cookie. At least 32 characters of randomness. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=replace-with-at-least-32-random-characters

# ── Public GitHub releases ───────────────────────────────────────────────────
# The repository that holds the releases: https://github.com/<GITHUB_OWNER>/<GITHUB_REPO>
GITHUB_OWNER=Aryan27-max
GITHUB_REPO=Atlas

# Optional, recommended. Downloads work without it, but GitHub then allows only 60
# API requests an hour per server address; a token raises that to 5,000.
# A fine-grained token with "Public repositories (read-only)" access is enough.
# Used only on the server. It never reaches the browser.
GITHUB_TOKEN=github_pat_replace_me

# Which file in the latest release is which installer. * matches anything, ? matches
# one character, and matching ignores upper/lower case. These defaults match the
# names Atlas's build already produces (app/electron-builder.yml in the main repository):
#   Atlas-<version>-arm64.dmg, Atlas-<version>-x64.dmg, Atlas-Setup-<version>-x64.exe
ASSET_PATTERN_MAC_ARM64=Atlas-*-arm64.dmg
ASSET_PATTERN_MAC_X64=Atlas-*-x64.dmg
ASSET_PATTERN_WIN_X64=Atlas-Setup-*-x64.exe

# ── Optional ─────────────────────────────────────────────────────────────────
# The site's public address, for link previews. Read at build time; Vercel fills it in by itself.
# SITE_URL=https://atlas.example.com
# How long to reuse the latest-release lookup, in seconds (default 300).
# RELEASE_CACHE_SECONDS=300
# Only for GitHub Enterprise Server, or a local stand-in while testing.
# GITHUB_API_URL=https://api.github.com
